---
import MotionReveal from './motion/MotionReveal';

const projects = [
  {
    title: 'AI Study Assistant',
    description:
      'A productivity-focused web app that helps students organize notes, summarize content, and prepare quizzes with AI-powered workflows.',
    technologies: ['Astro', 'TypeScript', 'FastAPI', 'PostgreSQL'],
    link: '#',
    github: '#',
    status: 'Featured'
  },
  {
    title: 'Smart Task Classifier',
    description:
      'A machine learning project that categorizes and prioritizes tasks from natural language input for better daily planning.',
    technologies: ['Python', 'Scikit-learn', 'Pandas', 'Docker'],
    link: '#',
    github: '#',
    status: 'In Progress'
  },
  {
    title: 'Portfolio Analytics Dashboard',
    description:
      'An interactive dashboard that visualizes visitor behavior, section engagement, and conversion flow for personal portfolio websites.',
    technologies: ['React', 'Chart.js', 'Supabase', 'REST API'],
    link: '#',
    github: '#',
    status: 'Case Study'
  }
];
---

<section id="projects" class="relative px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {projects.map((project, index) => (
        <MotionReveal client:visible delay={0.08 * index}>
          <article class="project-card h-full rounded-2xl border border-(--border) bg-(--surface) p-6 backdrop-blur-sm">
            <div class="mb-5 flex items-center justify-between gap-3">
              <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-300">
                {project.status}
              </span>
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-(--accent) shadow-[0_0_18px_rgba(88,166,255,0.75)]"></span>
            </div>

            <h3 class="text-2xl font-bold text-white">{project.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{project.description}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="rounded-full border border-white/12 bg-[#0d1117] px-3 py-1 text-xs font-semibold text-slate-300">
                  {tech}
                </span>
              ))}
            </div>

            <div class="mt-7 flex flex-wrap gap-3">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg bg-(--accent) px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-[#0d1117] transition-colors hover:bg-[#388bfd]"
              >
                View Live
              </a>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-slate-200 transition-colors hover:border-(--accent) hover:text-(--accent)"
              >
                Source Code
              </a>
            </div>
          </article>
        </MotionReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .project-card {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(88, 166, 255, 0.48);
    box-shadow: 0 26px 56px rgba(0, 0, 0, 0.38);
  }
</style>
