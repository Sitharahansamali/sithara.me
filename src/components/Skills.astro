---
import MotionReveal from './motion/MotionReveal';

const skillCategories = [
  {
    title: 'Programming Languages',
    accent: '#63b3ff',
    items: [
      { name: 'Python', icon: 'PY' },
      { name: 'Java', icon: 'JV' },
      { name: 'C', icon: 'C' },
      { name: 'C#', icon: 'C#' }
    ]
  },
  {
    title: 'Frontend Development',
    accent: '#5eead4',
    items: [
      { name: 'HTML', icon: 'H' },
      { name: 'CSS', icon: 'C' },
      { name: 'JavaScript', icon: 'JS' },
      { name: 'React', icon: 'R' },
      { name: 'Astro', icon: 'AS' }
    ]
  },
  {
    title: 'Backend Development',
    accent: '#93c5fd',
    items: [
      { name: 'FastAPI', icon: 'FA' },
      { name: 'REST APIs', icon: 'API' },
      { name: 'PHP', icon: 'PHP' }
    ]
  },
  {
    title: 'Machine Learning & Data Science',
    accent: '#fca5a5',
    items: [
      { name: 'Scikit-learn', icon: 'SK' },
      { name: 'TensorFlow', icon: 'TF' },
      { name: 'PyTorch', icon: 'PT' },
      { name: 'Pandas', icon: 'PD' },
      { name: 'NumPy', icon: 'NP' },
      { name: 'Matplotlib', icon: 'MP' },
      { name: 'OpenCV', icon: 'CV' }
    ]
  },
  {
    title: 'Cloud & AI Platforms',
    accent: '#7dd3fc',
    items: [
      { name: 'AWS', icon: 'AWS' },
      { name: 'Azure', icon: 'AZ' },
      { name: 'Docker Hub', icon: 'DH' },
      { name: 'Hugging Face', icon: 'HF' },
      { name: 'Google Colab', icon: 'GC' }
    ]
  },
  {
    title: 'Tools & Environment',
    accent: '#6ee7b7',
    items: [
      { name: 'Git', icon: 'G' },
      { name: 'GitHub', icon: 'GH' },
      { name: 'VS Code', icon: 'VS' },
      { name: 'Jupyter', icon: 'JP' },
      { name: 'Linux', icon: 'LX' }
    ]
  },
  {
    title: 'Design & Productivity',
    accent: '#f9a8d4',
    items: [
      { name: 'Figma', icon: 'FG' },
      { name: 'Canva', icon: 'CV' }
    ]
  },
  {
    title: 'Databases',
    accent: '#a7f3d0',
    items: [
      { name: 'MongoDB', icon: 'MG' },
      { name: 'PostgreSQL', icon: 'PG' },
      { name: 'MySQL', icon: 'MY' },
      { name: 'SQLite', icon: 'SQ' },
      { name: 'Supabase', icon: 'SB' }
    ]
  }
];
---

<section id="skills" class="px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <MotionReveal client:visible className="mx-auto mb-6 max-w-2xl text-center">
      <h2 class="section-title">Skills</h2>
      <p class="section-description">
        The stack I use for software development, AI work, and everyday productivity.
      </p>
    </MotionReveal>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {skillCategories.map((category, categoryIndex) => (
        <MotionReveal client:visible delay={0.05 * categoryIndex}>
          <article class="skill-card rounded-2xl border border-(--border) bg-(--surface) p-5" style={`--card-accent: ${category.accent};`}>
            <h3 class="text-lg font-bold text-white">{category.title}</h3>
            <div class="mt-4 flex flex-wrap gap-2.5">
              {category.items.map((item, itemIndex) => (
                <span
                  class="skill-pill inline-flex items-center gap-2 rounded-full border border-white/10 bg-[#0d1117]/80 px-3 py-1.5 text-xs font-semibold text-slate-200"
                  style={`animation-delay: ${itemIndex * 65}ms;`}
                >
                  <span class="pill-icon inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-(--card-accent)/20 px-1 text-[10px] font-bold text-(--card-accent)">
                    {item.icon}
                  </span>
                  {item.name}
                </span>
              ))}
            </div>
          </article>
        </MotionReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-card {
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--card-accent) 50%, transparent);
  }

  .skill-pill {
    animation: pillIn 0.45s ease both;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .skill-pill:hover {
    border-color: color-mix(in srgb, var(--card-accent) 58%, transparent);
    transform: translateY(-1px);
  }

  @keyframes pillIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section-title {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.section-description {
		text-align: center;
		font-size: 1rem;
		color: #8b949e;
		margin-bottom: 1.8rem;
	}
    
</style>
