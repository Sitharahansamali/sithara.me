---
const skillCategories = [
	{
		title: "Programming Languages",
		accent: "#63b3ff",
		items: [
			{ name: "Python", icon: "🐍", color: "#ffd43b" },
			{ name: "Java", icon: "☕", color: "#f89820" },
			{ name: "C", icon: "C", color: "#7cb8ff" },
			{ name: "C#", icon: "C#", color: "#d585ff" }
		]
	},
	{
		title: "Frontend Development",
		accent: "#5eead4",
		items: [
			{ name: "HTML", icon: "H", color: "#ff7f50" },
			{ name: "CSS", icon: "C", color: "#4ea8ff" },
			{ name: "JavaScript", icon: "JS", color: "#ffe066" },
			{ name: "React", icon: "⚛", color: "#61dafb" },
			{ name: "Astro", icon: "A", color: "#ff8f66" }
		]
	},
	{
		title: "Backend Development",
		accent: "#93c5fd",
		items: [
			{ name: "FastAPI", icon: "F", color: "#4ade80" },
			{ name: "REST APIs", icon: "API", color: "#93c5fd" },
			{ name: "PHP", icon: "php", color: "#c4b5fd" }
		]
	},
	{
		title: "Machine Learning & Data Science",
		accent: "#fca5a5",
		items: [
			{ name: "Scikit-learn", icon: "SK", color: "#fb923c" },
			{ name: "Pandas", icon: "PD", color: "#c4b5fd" },
			{ name: "NumPy", icon: "NP", color: "#93c5fd" },
			{ name: "Matplotlib", icon: "MP", color: "#fca5a5" },
			{ name: "OpenCV", icon: "CV", color: "#86efac" }
		]
	},
	{
		title: "Cloud & AI Platforms",
		accent: "#7dd3fc",
		items: [
			{ name: "AWS", icon: "AWS", color: "#fbbf24" },
			{ name: "Microsoft Azure", icon: "AZ", color: "#7dd3fc" },
			{ name: "Hugging Face", icon: "HF", color: "#fde68a" },
			{ name: "Google Colab", icon: "GC", color: "#fb923c" }
		]
	},
	{
		title: "Tools & Development Environment",
		accent: "#6ee7b7",
		items: [
			{ name: "Git", icon: "Git", color: "#f87171" },
			{ name: "GitHub", icon: "GH", color: "#d1d5db" },
			{ name: "VS Code", icon: "VS", color: "#60a5fa" },
			{ name: "Jupyter Notebook", icon: "JP", color: "#fb923c" },
			{ name: "Docker", icon: "DK", color: "#7dd3fc" },
			{ name: "Linux", icon: "🐧", color: "#fde68a" }
		]
	},
	{
		title: "Design & Productivity Tools",
		accent: "#f9a8d4",
		items: [
			{ name: "Figma", icon: "Fg", color: "#f472b6" },
			{ name: "Canva", icon: "Cv", color: "#67e8f9" }
		]
	},
	{
		title: "Databases",
		accent: "#a7f3d0",
		items: [
			{ name: "MySQL", icon: "MY", color: "#93c5fd" },
			{ name: "SQLite", icon: "SQ", color: "#d1d5db" },
			{ name: "Supabase", icon: "SB", color: "#86efac" }
		]
	},
	{
		title: "Automation / Other Technologies",
		emoji: "🚀",
		accent: "#c4b5fd",
		items: [{ name: "n8n", icon: "n8n", color: "#fca5a5" }]
	}
];
---

<section id="skills" class="skills">
	<div class="container">
		<div class="skills-shell">
			<h2 class="section-title">Skills</h2>
			<p class="section-description">A technical snapshot of my development stack and tools.</p>

			<div class="skills-board">
				{skillCategories.map((category, index) => (
					<article class={`skill-category ${index === 0 ? "first" : ""}`} style={`--accent: ${category.accent};`}>
						<h3 class="category-heading">
							<span class="category-emoji" aria-hidden="true">{category.emoji}</span>
							<span>{category.title}</span>
						</h3>

						<div class="icon-row">
							{category.items.map((item) => (
								<div class="icon-tile" aria-label={item.name} title={item.name}>
									<span class="tile-text" style={`color: ${item.color};`}>{item.icon}</span>
								</div>
							))}
						</div>

						<p class="category-line">
							<span class="diamond">◆</span>
							{category.items.map((item) => item.name).join(", ")}
						</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.skills {
		padding: 5rem 1.5rem;
		background:
			radial-gradient(circle at 12% 6%, rgba(23, 183, 148, 0.18), transparent 35%),
			linear-gradient(180deg, #0d3b3f 0%, #0a3034 100%);
	}

	.container {
		max-width: 1180px;
		margin: 0 auto;
	}

	.skills-shell {
		padding: 2rem 1.4rem;
		border-radius: 22px;
		background:
			radial-gradient(circle at 20% 0%, rgba(23, 183, 148, 0.2), transparent 45%),
			linear-gradient(180deg, #0a2f34 0%, #08282d 100%);
		border: 1px solid rgba(155, 239, 224, 0.28);
		box-shadow: 0 22px 50px rgba(2, 19, 21, 0.4);
	}

	.section-title {
		text-align: center;
		font-size: clamp(2rem, 5vw, 2.5rem);
		margin: 0;
		color: #ffffff;
	}

	.section-description {
		text-align: center;
		font-size: 1rem;
		color: #c1d8da;
		margin: 0.9rem 0 2.2rem;
	}

	.skills-board {
		background: linear-gradient(180deg, #0c4d55 0%, #0a444b 100%);
		border: 1px solid rgba(23, 183, 148, 0.38);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 20px 45px rgba(3, 24, 27, 0.35);
	}

	.skill-category {
		padding: 1.45rem 1.3rem 1.25rem;
		border-top: 1px solid rgba(183, 243, 232, 0.28);
	}

	.skill-category.first {
		border-top: none;
	}

	.category-heading {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		font-size: 1.65rem;
		font-weight: 700;
		color: #f1ffff;
	}

	.category-emoji {
		font-size: 1.15rem;
	}

	.icon-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 0.9rem;
	}

	.icon-tile {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
		background: linear-gradient(160deg, #145b64 0%, #1a6a74 100%);
		border: 1px solid rgba(183, 243, 232, 0.32);
	}

	.tile-text {
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: 0.01em;
	}

	.category-line {
		margin: 0.95rem 0 0;
		font-size: 1rem;
		line-height: 1.6;
		color: #e2f4f5;
	}

	.diamond {
		color: var(--accent);
		margin-right: 0.5rem;
		font-size: 0.8rem;
	}

	@media (max-width: 768px) {
		.skills {
			padding: 4rem 1rem;
		}

		.skills-shell {
			padding: 1.3rem 0.8rem;
			border-radius: 16px;
		}

		.skill-category {
			padding: 1.1rem 0.9rem 1rem;
		}

		.category-heading {
			font-size: 1.1rem;
		}

		.icon-tile {
			width: 50px;
			height: 50px;
		}

		.tile-text {
			font-size: 1.05rem;
		}

		.category-line {
			font-size: 0.95rem;
		}
	}
</style>
