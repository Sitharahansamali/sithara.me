---
import MotionReveal from './motion/MotionReveal';

const name = 'Sithara Hansamali';
const title = 'AI Enthusiast · Computer Science Undergraduate';
const bio = 'Passionate about Artificial Intelligence, data-driven solutions, and innovative technologies. I enjoy learning machine learning concepts, building smart systems, and exploring how AI can solve real-world challenges.';

const focusPoints = ['Machine Learning', 'Data-Driven Systems', 'Cloud AI'];
---

<section id="hero" class="relative isolate min-h-screen overflow-hidden pt-28 md:pt-32">
  <div class="hero-orb hero-orb-left" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-right" aria-hidden="true"></div>

  <div class="mx-auto flex w-full max-w-6xl flex-col items-center px-4 pb-20 text-center sm:px-6 lg:px-8">
    <MotionReveal client:visible delay={0.05}>
      <p class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-(--accent)">
        Portfolio 2026
      </p>
    </MotionReveal>

    <MotionReveal client:visible delay={0.15}>
      <h1 class="mt-6 max-w-5xl text-[clamp(2.8rem,8vw,6.3rem)] font-black uppercase leading-[0.9] tracking-[-0.02em] text-white" style="font-family: var(--font-display);">
        <span class="hero-name-gradient"><span style="background: linear-gradient(90deg, #58a6ff 0%, #a371ff 25%, #ff1493 50%, #a371ff 75%, #58a6ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">{name}</span></span>
      </h1>
    </MotionReveal>

    <MotionReveal client:visible delay={0.25}>
      <p class="mt-6 text-base font-semibold text-slate-300 sm:text-xl">{title}</p>
    </MotionReveal>

    <MotionReveal client:visible delay={0.35}>
      <p class="mt-5 max-w-3xl text-sm leading-8 text-slate-400 sm:text-lg">{bio}</p>
    </MotionReveal>

    <MotionReveal client:visible delay={0.45}>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        {focusPoints.map((point) => (
          <span class="rounded-full border border-(--border) bg-(--surface) px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-300 shadow-[0_8px_24px_rgba(0,0,0,0.28)]">{point}</span>
        ))}
      </div>
    </MotionReveal>

    <MotionReveal client:visible delay={0.55}>
      <div class="mt-10 flex w-full max-w-md flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/projects"
          class="w-full rounded-xl bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 px-6 py-3 text-center text-sm font-bold text-[#0d1117] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(88,166,255,0.5)] sm:w-auto"
        >
          View Portfolio
        </a>
        <a
          href="/assets/cv/Sithara Hansamali.pdf"
          download="Sithara Hansamali.pdf"
          class="w-full rounded-xl bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 px-6 py-3 text-center text-sm font-bold text-[#0d1117] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(255,20,147,0.5)]"
        >
          Download CV
        </a>
      </div>
    </MotionReveal>

    <MotionReveal client:visible delay={0.7}>
      <div class="mt-16 inline-flex items-center justify-center">
        <span class="mouse-indicator" aria-hidden="true"><span class="wheel"></span></span>
      </div>
    </MotionReveal>
  </div>
</section>

<style>
  .hero-name-gradient {
    display: inline-block;
  }

  .hero-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(8px);
    opacity: 0.45;
    pointer-events: none;
    z-index: -1;
  }

  .hero-orb-left {
    width: 340px;
    height: 340px;
    background: radial-gradient(circle at center, rgba(88, 166, 255, 0.35) 0%, transparent 70%);
    left: -120px;
    top: 120px;
    animation: orbFloatLeft 10s ease-in-out infinite;
  }

  .hero-orb-right {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle at center, rgba(109, 99, 255, 0.34) 0%, transparent 72%);
    right: -110px;
    top: 180px;
    animation: orbFloatRight 12s ease-in-out infinite;
  }

  .mouse-indicator {
    position: relative;
    width: 28px;
    height: 44px;
    border-radius: 16px;
    border: 2px solid rgba(88, 166, 255, 0.35);
    display: inline-block;
  }

  .wheel {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    border-radius: 999px;
    background: rgba(88, 166, 255, 0.92);
    transform: translateX(-50%);
    animation: wheelDrop 1.6s ease-in-out infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  @keyframes orbFloatLeft {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-18px) translateX(10px); }
  }

  @keyframes orbFloatRight {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(18px) translateX(-12px); }
  }

  @keyframes wheelDrop {
    0%, 100% { opacity: 1; transform: translateX(-50%) translateY(0); }
    50% { opacity: 0.25; transform: translateX(-50%) translateY(10px); }
  }
</style>
