---
import profileImage from '../assets/FB_IMG_1703424324277.jpg';

// You can customize these values later!
const name = "Sithara Hansamali";
const title = "AI Enthusiast | Computer Science Undergraduate";
const bio = "Passionate about Artificial Intelligence, data-driven solutions, and innovative technologies. I enjoy learning machine learning concepts, building smart systems, and exploring how AI can solve real-world challenges.";
---

<section class="hero" id="hero">
	<div class="container">
		<div class="hero-grid">
			<div class="hero-image-container">
				<div class="image-wrapper">
					<img src={profileImage.src} alt={name} class="profile-image" />
				</div>
			</div>
			<div class="hero-content">
				<h1 class="hero-title">
					Hi, I'm <span class="highlight">{name}</span>
				</h1>
				<h2 class="hero-subtitle">{title}</h2>
				<p class="hero-bio">{bio}</p>
			<div class="hero-cta">
				<a href="/about" class="btn btn-primary">About Me</a>
				<a href="/contact" class="btn btn-secondary">Connect With Me</a>
			</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 2rem 4rem;
		background: transparent;
		color: white;
	}

	.container {
		max-width: 1200px;
		width: 100%;
		margin: 0 auto;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
		animation: fadeInUp 1s ease-out;
	}

	.hero-image-container {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.image-wrapper {
		position: relative;
		width: 350px;
		height: 350px;
		border-radius: 50%;
		overflow: hidden;
		border: 5px solid #1f6feb;
		box-shadow: 0 0 40px rgba(31, 111, 235, 0.4);
		animation: float 3s ease-in-out infinite;
	}

	.profile-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.image-wrapper:hover .profile-image {
		transform: scale(1.1);
	}

	.hero-content {
		text-align: left;
	}

	@keyframes float {
		0%, 100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-20px);
		}
	}

	.hero-title {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.highlight {
		color: #1f6feb;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
	}

	.hero-subtitle {
		font-size: 2rem;
		font-weight: 400;
		margin-bottom: 1.5rem;
		color: rgba(255, 255, 255, 0.9);
	}

	.hero-bio {
		font-size: 1.25rem;
		line-height: 1.8;
		max-width: 700px;
		margin: 0 auto 2.5rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		padding: 1rem 2rem;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.3s ease;
		display: inline-block;
	}

	.btn-primary {
		background: #1f6feb;
		color: #0d1117;
		font-weight: 700;
	}

	.btn-primary:hover {
		background: #388bfd;
		transform: translateY(-2px);
		box-shadow: 0 10px 20px rgba(31, 111, 235, 0.3);
	}

	.btn-secondary {
		background: transparent;
		color: white;
		border: 2px solid white;
	}

	.btn-secondary:hover {
		background: #1f6feb;
		color: #0d1117;
		transform: translateY(-2px);
		border-color: #1f6feb;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 968px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}

		.hero-content {
			text-align: center;
		}

		.image-wrapper {
			width: 280px;
			height: 280px;
		}

		.hero-title {
			font-size: 2.5rem;
		}

		.hero-subtitle {
			font-size: 1.5rem;
		}

		.hero-bio {
			font-size: 1.1rem;
		}

		.hero-cta {
			justify-content: center;
		}

		.hero {
			padding-top: 7rem;
		}
	}
</style>
