---
const certificates = [
	{
		title: "Machine Learning Foundations",
		issuer: "Coursera",
		year: "2025",
		link: "#"
	},
	{
		title: "Python for Data Science",
		issuer: "DataCamp",
		year: "2024",
		link: "#"
	},
	{
		title: "Responsive Web Design",
		issuer: "freeCodeCamp",
		year: "2024",
		link: "#"
	}
];
---

<section id="certificates" class="certificates">
	<div class="container">
		<h2 class="section-title">Certificates</h2>
		<p class="section-description">Selected certifications that support my technical journey.</p>

		<div class="cert-grid">
			{certificates.map(cert => (
				<article class="cert-card">
					<div class="cert-meta">
						<span class="cert-year">{cert.year}</span>
						<span class="cert-issuer">{cert.issuer}</span>
					</div>
					<h3>{cert.title}</h3>
					<a href={cert.link} class="cert-link" target="_blank" rel="noopener noreferrer">View Credential</a>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.certificates {
		padding: 5rem 2rem;
		background: #0d1117;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-title {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: #fff;
	}

	.section-description {
		text-align: center;
		font-size: 1.1rem;
		color: #8b949e;
		margin-bottom: 2.2rem;
	}

	.cert-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1rem;
	}

	.cert-card {
		padding: 1.2rem;
		border-radius: 14px;
		background: rgba(30, 30, 46, 0.5);
		border: 1px solid rgba(31, 111, 235, 0.25);
	}

	.cert-meta {
		display: flex;
		justify-content: space-between;
		color: #58a6ff;
		font-size: 0.9rem;
		margin-bottom: 0.6rem;
	}

	.cert-card h3 {
		font-size: 1.1rem;
		color: #fff;
		margin-bottom: 1rem;
	}

	.cert-link {
		text-decoration: none;
		color: #58a6ff;
		border-bottom: 1px dashed #1f6feb;
	}

	.cert-link:hover {
		color: #1f6feb;
	}
</style>