---
import MotionReveal from './motion/MotionReveal';
const certificates = [
	{
		title: "Get Started with Anaconda",
		issuer: "Anaconda, Inc.",
		year: "2026",
		link: "https://learning.anaconda.com/certificates/xdfb4igyob"
	},
	{
		title: "AWS Artificial Intelligence Practitioner Learning Plan - Certificate Series",
		issuer: "AWS",
		year: "2026",
		link: "https://drive.google.com/file/d/1KBx2eJ3Dsk6qqQNMOeedrOCyfGJa3eGG/view?usp=sharing"
	},
	{
		title: "Google AI Essentials",
		issuer: "Google",
		year: "2026",
		link: "https://www.coursera.org/account/accomplishments/specialization/18IL96JZM5UO"
	},
	{
		title: "Claude Code in Action",
		issuer: "Anthropic",
		year: "2026",
		link: "https://verify.skilljar.com/c/uaz85bk2tsje"
	},
	{
		title: "Azure AI Fundamentals: AI",
		issuer: "ScholarHat",
		year: "2026",
		link: "https://drive.google.com/file/d/1zH_BuqblyMWBhGcHaNAUPhC3p9mKAwHd/view?usp=sharing"
	},
	{
		title: "Generative AI: Introduction and Applications",
		issuer: "IBM",
		year: "2026",
		link: "https://www.coursera.org/account/accomplishments/verify/RRFC86Z63584"
	},
	{
		title: "Azure Fundamentals Course for Beginners",
		issuer: "ScholarHat",
		year: "2026",
		link: "https://drive.google.com/file/d/1p1SJ2tM2avX3fUr_3lKrPyTcvYSSZ0DA/view?usp=sharing"
	},
	{
		title: "Linux Essentials Certification",
		issuer: "Cisco Networking Academy",
		year: "2026",
		link: "https://drive.google.com/file/d/1gplms0i49eE1_14MApqmbDOfEWAeA6Ki/view?usp=sharing"
	},
	{
		title: "Exploratory Data Analysis With Python and Pandas",
		issuer: "IBM",
		year: "2025",
		link: "https://www.coursera.org/account/accomplishments/verify/0U2ACFWQFAU7"
	},
	{
		title: "Python for Data Science, AI & Development",
		issuer: "IBM",
		year: "2025",
		link: "https://www.coursera.org/account/accomplishments/verify/0U2ACFWQFAU7"
	}
];
---

<section id="certificates" class="certificates">
		<div class="container">
				<MotionReveal client:visible className="mx-auto mb-6 max-w-2xl text-center">
					<h2 class="section-title">Certificates</h2>
					<p class="section-description">Selected certifications that support my technical journey.</p>
				</MotionReveal>

		<div class="cert-grid">
			{certificates.map((cert, idx) => (
				<MotionReveal client:visible delay={0.04 * idx}>
				  <article class="cert-card">
					<div class="cert-meta">
						<span class="cert-year">{cert.year}</span>
						<span class="cert-issuer">{cert.issuer}</span>
					</div>
					<h3>{cert.title}</h3>
					<a href={cert.link} class="cert-link" target="_blank" rel="noopener noreferrer">View Credential</a>
				  </article>
				</MotionReveal>
			))}
		</div>
	</div>
</section>

<style>
	.certificates {
		padding: 8rem 2rem 5rem;
		background: transparent;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-title {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.section-description {
		text-align: center;
		font-size: 1rem;
		color: #8b949e;
		margin-bottom: 1.8rem;
	}

	.cert-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1rem;
	}

	.cert-card {
		padding: 1.2rem;
		border-radius: 14px;
		background: rgba(30, 30, 46, 0.5);
		border: 1px solid rgba(31, 111, 235, 0.25);
	}

	.cert-meta {
		display: flex;
		justify-content: space-between;
		color: #58a6ff;
		font-size: 0.9rem;
		margin-bottom: 0.6rem;
	}

	.cert-card h3 {
		font-size: 1.1rem;
		color: #fff;
		margin-bottom: 1rem;
	}

	.cert-link {
		text-decoration: none;
		color: #58a6ff;
		border-bottom: 1px dashed #1f6feb;
	}

	.cert-link:hover {
		color: #1f6feb;
	}
</style>