---
import profileImage2 from '../assets/about-sithara.jpg';
import MotionReveal from './motion/MotionReveal';

const about = {
  intro: 'I am a Computer Science undergraduate focused on Artificial Intelligence and Machine Learning.',
  description:
    'I build practical software and AI solutions using Python and FastAPI, with a focus on clean engineering, scalability, and real-world impact.',
  highlights: [
    'AI and Machine Learning foundations',
    'Python and FastAPI project experience',
    'Strong problem-solving mindset',
    'Open to internship and collaboration opportunities'
  ]
};

const stats = [
  { label: 'Projects Built', value: '12+' },
  { label: 'Core Technologies', value: '20+' },
  { label: 'Learning Streak', value: '2+ Years' }
];
---

<section id="about" class="px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <MotionReveal client:visible className="mx-auto mb-6 max-w-2xl text-center">
      <h2 class="section-title">About Me</h2>
      <p class="section-description">
        A focused view of my background, strengths, and the direction I’m building toward.
      </p>
    </MotionReveal>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
      <MotionReveal client:visible delay={0.1} className="lg:col-span-2">
        <article class="about-panel h-full rounded-2xl border border-(--border) bg-(--surface) p-6">
          <div class="mx-auto w-full max-w-xs overflow-hidden rounded-3xl border border-white/10 bg-[#0d1117] p-2 shadow-[0_18px_45px_rgba(0,0,0,0.32)]">
            <img src={profileImage2.src} alt="Sithara Hansamali" class="h-full w-full rounded-2xl object-cover" loading="lazy" />
          </div>

          <div class="mt-6 space-y-3">
            <h3 class="text-xl font-bold text-white">Computer Science Undergraduate</h3>
            <p class="text-sm leading-7 text-slate-400">{about.intro}</p>
          </div>
        </article>
      </MotionReveal>

      <div class="grid grid-cols-1 gap-6 lg:col-span-3">
        <MotionReveal client:visible delay={0.2}>
          <article class="about-panel rounded-2xl border border-(--border) bg-(--surface) p-6">
            <h3 class="text-xl font-bold text-white">Professional Summary</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{about.description}</p>

            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {about.highlights.map((item) => (
                <li class="rounded-xl border border-white/10 bg-[#0d1117]/70 px-4 py-3 text-sm text-slate-300">
                  <span class="mr-2 inline-block h-2 w-2 rounded-full bg-(--accent)"></span>{item}
                </li>
              ))}
            </ul>
          </article>
        </MotionReveal>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {stats.map((stat, index) => (
            <MotionReveal client:visible delay={0.28 + index * 0.08}>
              <article class="about-panel rounded-2xl border border-(--border) bg-(--surface) p-5 text-center">
                <p class="text-3xl font-black text-(--accent)">{stat.value}</p>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">{stat.label}</p>
              </article>
            </MotionReveal>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-panel {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .about-panel:hover {
    transform: translateY(-4px);
    border-color: rgba(88, 166, 255, 0.42);
  }

  .section-title {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.section-description {
		text-align: center;
		font-size: 1rem;
		color: #8b949e;
		margin-bottom: 1.8rem;
	}
</style>
