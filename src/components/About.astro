---
const about = {
	intro: "I am a Computer Science undergraduate focused on Artificial Intelligence and Machine Learning.",
	description: "I build practical software and AI solutions using Python and FastAPI, with a focus on clean engineering and real-world impact.",
	meta: {
		role: "AI/ML Learner",
		focus: "Intelligent Systems",
		status: "Open to Internships"
	},
	highlights: [
		"AI and Machine Learning foundations",
		"Python and FastAPI project experience",
		"Strong problem-solving mindset"
	]
}
---

<section id="about" class="about section-shell">
	<div class="container">
		<header class="about-header">
			<p class="eyebrow">Get To Know Me</p>
			<h2 class="section-title">About</h2>
		</header>

		<div class="about-grid">
			<article class="info-card">
				<h3>Profile</h3>
				<p class="about-intro">{about.intro}</p>
				<p class="about-description">{about.description}</p>
			</article>

			<aside class="info-card facts" aria-label="About quick facts">
				<h3>Quick Facts</h3>
				<ul class="facts-list">
					<li>
						<span class="label">Current Role</span>
						<strong>{about.meta.role}</strong>
					</li>
					<li>
						<span class="label">Core Focus</span>
						<strong>{about.meta.focus}</strong>
					</li>
					<li>
						<span class="label">Availability</span>
						<strong>{about.meta.status}</strong>
					</li>
				</ul>
			</aside>
		</div>
	</div>

	<div class="container">
		<h3 class="highlights-title">Core Strengths</h3>
		<ul class="about-highlights">
			{about.highlights.map((item) => (
				<li>
					<span class="dot"></span>
					<span>{item}</span>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.about {
		padding: 6rem 2rem;
		background:
			radial-gradient(circle at 15% 15%, rgba(23, 183, 148, 0.18), transparent 40%),
			radial-gradient(circle at 85% 10%, rgba(180, 245, 232, 0.15), transparent 35%),
			linear-gradient(180deg, #0b373b 0%, #0d4247 45%, #0f4d52 100%);
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.about-header {
		margin-bottom: 1.2rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 1rem;
		align-items: start;
	}

	.info-card {
		background: rgba(5, 28, 31, 0.72);
		border: 1px solid rgba(173, 235, 222, 0.42);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow: 0 12px 28px rgba(2, 22, 25, 0.3);
	}

	.info-card h3 {
		margin: 0 0 0.8rem;
		font-size: 1.3rem;
		color: #ffffff;
	}

	.eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.35rem 0.75rem;
		margin: 0 0 0.7rem;
		border-radius: 999px;
		background: rgba(186, 255, 241, 0.2);
		color: #d9fff7;
	}

	.section-title {
		font-size: clamp(2rem, 5vw, 2.6rem);
		margin: 0;
		color: #ffffff;
		line-height: 1.1;
	}

	.about-intro {
		font-size: 1.08rem;
		line-height: 1.6;
		color: #ecfffc;
		margin: 0 0 0.8rem;
	}

	.about-description {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: #d2eced;
	}

	.facts-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.8rem;
	}

	.facts-list li {
		padding: 0.95rem 1rem;
		border-radius: 10px;
		background: rgba(9, 54, 58, 0.92);
		border: 1px solid rgba(149, 241, 222, 0.45);
	}

	.facts-list .label {
		display: block;
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #b7f1e3;
	}

	.facts-list strong {
		display: block;
		margin-top: 0.25rem;
		font-size: 1.08rem;
		font-weight: 700;
		color: #f3ffff;
	}

	.highlights-title {
		margin: 1.8rem 0 0.9rem;
		font-size: 1.35rem;
		color: #ffffff;
	}

	.about-highlights {
		margin-top: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 0.9rem;
		list-style: none;
		padding: 0;
	}

	.about-highlights li {
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
		background: rgba(7, 42, 46, 0.8);
		border: 1px solid rgba(166, 236, 222, 0.3);
		border-radius: 14px;
		padding: 0.95rem 1rem;
		color: #f4fcfd;
		line-height: 1.5;
	}

	.about-highlights li .dot {
		width: 0.6rem;
		height: 0.6rem;
		margin-top: 0.45rem;
		border-radius: 999px;
		background: #57f7d4;
		box-shadow: 0 0 0 5px rgba(87, 247, 212, 0.2);
		flex-shrink: 0;
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.info-card {
			padding: 1.4rem;
		}
	}
</style>