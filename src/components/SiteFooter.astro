---
import { Mail, FileText, ArrowUp } from 'lucide-react';
---

<footer class="relative border-t border-white/10 bg-[#08111F] px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 sm:flex-row">
    {/* Left Copyright */}
    <div class="flex flex-col items-center sm:items-start">
      <a href="/" class="font-mono text-lg font-extrabold tracking-wider text-[#F8FAFC]" style="font-family: 'Space Grotesk', sans-serif;">
        sithara<span class="text-[#7C3AED]">.me</span>
      </a>
      <p class="mt-1 text-xs text-[#94A3B8]">
        © {new Date().getFullYear()} Sithara Hansamali. All rights reserved. Artificial Intelligence & ML Engineer.
      </p>
    </div>

    {/* Center Socials */}
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/Sitharahansamali"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-[#111827] text-[#CBD5E1] transition-all hover:border-[#7C3AED] hover:bg-[#7C3AED]/15 hover:text-white hover:shadow-[0_0_15px_rgba(124,58,237,0.3)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/in/sithara-hansamali-8663a1296/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-[#111827] text-[#CBD5E1] transition-all hover:border-[#38BDF8] hover:bg-[#38BDF8]/15 hover:text-[#38BDF8] hover:shadow-[0_0_15px_rgba(56,189,248,0.3)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>

      <a
        href="mailto:sitharah.me@gmail.com"
        aria-label="Email"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-[#111827] text-[#CBD5E1] transition-all hover:border-[#22D3EE] hover:bg-[#22D3EE]/15 hover:text-[#22D3EE]"
      >
        <Mail className="h-4 w-4" />
      </a>

      <a
        href="/assets/cv/Sithara Hansamali.pdf"
        download="Sithara Hansamali.pdf"
        aria-label="Resume PDF"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-[#111827] text-[#CBD5E1] transition-all hover:border-[#22C55E] hover:bg-[#22C55E]/15 hover:text-[#22C55E]"
      >
        <FileText className="h-4 w-4" />
      </a>
    </div>

    {/* Right Smooth Back to Top */}
    <a
      href="#hero"
      class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-[#CBD5E1] transition-colors hover:border-[#7C3AED] hover:text-white"
    >
      <span>Back to top</span>
      <ArrowUp className="h-3.5 w-3.5" />
    </a>
  </div>
</footer>