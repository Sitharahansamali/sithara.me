---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Sithara Hansamali | Artificial Intelligence & ML Engineer",
	description = "Portfolio of Sithara Hansamali - Computer Science undergraduate specializing in Artificial Intelligence, machine learning, AI agents, and scalable full-stack applications.",
	image = "/assets/sithara.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://sithara.me");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Sithara Hansamali" />
		<meta name="keywords" content="Sithara Hansamali, AI Engineer, Machine Learning, Artificial Intelligence, Portfolio, Deep Learning, Python, FastAPI, React, PyTorch" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Orbitron:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="relative bg-[#080b11] text-[#f0f6fc] antialiased selection:bg-[#58a6ff] selection:text-black">
		<slot />
	</body>
</html>
