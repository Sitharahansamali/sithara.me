---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Your Name - Portfolio", description = "Welcome to my portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@500;700;800&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--page-bg:
			radial-gradient(circle at 15% 15%, rgba(31, 111, 235, 0.15), transparent 40%),
			radial-gradient(circle at 85% 10%, rgba(31, 111, 235, 0.1), transparent 35%),
			linear-gradient(180deg, #0d1117 0%, #010409 45%, #0d1117 100%);
		--surface: rgba(22, 27, 34, 0.8);
		--surface-strong: rgba(22, 27, 34, 0.96);
		--border: rgba(31, 111, 235, 0.25);
		--accent: #58a6ff;
		--font-body: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		--font-display: 'Orbitron', 'Inter', sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: var(--font-body);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		background: var(--page-bg);
		color: #fff;
		line-height: 1.5;
	}

	a {
		color: inherit;
	}
</style>
